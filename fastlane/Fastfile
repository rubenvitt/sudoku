default_platform(:ios)

platform :ios do
  desc "Upload the exported IPA to TestFlight and hand it to the external group"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    # The external group only exists after a first upload; until TESTFLIGHT_GROUP is set, just upload.
    group = ENV.fetch("TESTFLIGHT_GROUP", "")
    distribute = !group.empty?
    options = {
      api_key: api_key,
      ipa: ENV.fetch("IPA_PATH"),
      changelog: ENV.fetch("CHANGELOG"),
      distribute_external: distribute,
      groups: (distribute ? [group] : nil),
      skip_waiting_for_build_processing: !distribute
    }.compact
    pilot(options)
  end

  desc "Upload the App Store texts from fastlane/metadata (no binary, no screenshots, no submission)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    deliver(
      api_key: api_key,
      app_identifier: "dev.rubeen.sudoku",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true, # no HTML preview to confirm on a headless run
      precheck_include_in_app_purchases: false
    )
  end
end
