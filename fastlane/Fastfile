require "openssl"

default_platform(:ios)

APP_IDENTIFIER = "dev.rubeen.sudoku"

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Upload the exported IPA to TestFlight and hand it to the external group"
  lane :beta do
    # The external group only exists after a first upload; until TESTFLIGHT_GROUP is set, just upload.
    group = ENV.fetch("TESTFLIGHT_GROUP", "")
    distribute = !group.empty?
    options = {
      api_key: asc_api_key,
      ipa: ENV.fetch("IPA_PATH"),
      changelog: ENV.fetch("CHANGELOG"),
      distribute_external: distribute,
      groups: (distribute ? [group] : nil),
      skip_waiting_for_build_processing: !distribute
    }.compact
    begin
      pilot(options)
    rescue StandardError => e
      # Apple reviews one build per version for external testing at a time. While that review runs, later builds of
      # the version are uploaded and reach internal testers, but can't be handed to the external group yet.
      raise unless distribute && e.message.include?("Another build is in review")
      UI.important("Uploaded, but not handed to #{group}: another build of this version is still in beta review. " \
                   "Internal testers have it; add it to #{group} in App Store Connect once that review is done.")
    end
  end

  desc "Revoke the Apple Development certificates Xcode made on this CI runner"
  desc "Cloud signing creates one per fresh runner, and the team may only hold a few; left behind, they block later archives."
  lane :revoke_runner_certificates do
    pems = `security find-certificate -a -c "Apple Development" -p 2>/dev/null`
           .scan(/-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----/m)
    serials = pems.map { |pem| normalized_serial(OpenSSL::X509::Certificate.new(pem).serial.to_s(16)) }
    if serials.empty?
      UI.message("No Apple Development certificate on this runner, nothing to revoke")
      next
    end
    development = [
      Spaceship::ConnectAPI::Certificate::CertificateType::DEVELOPMENT,
      Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DEVELOPMENT
    ]
    asc_api_key
    # Only a certificate whose private key sits in this runner's keychain matches, so certificates made on a Mac stay.
    Spaceship::ConnectAPI::Certificate.all.each do |certificate|
      next unless development.include?(certificate.certificate_type)
      next unless serials.include?(normalized_serial(certificate.serial_number))
      certificate.delete!
      UI.success("Revoked #{certificate.name} (#{certificate.serial_number}), made on this runner")
    end
  end

  desc "Upload texts, review notes and (if present) fastlane/screenshots; no binary, no submission"
  lane :metadata do
    deliver(listing_options)
  end

  desc "Upload texts and screenshots, attach a TestFlight build and submit the version for review"
  desc "Pass build_number:N to pick a build; without it the latest processed build is used."
  desc "The approved version is not released automatically; release it by hand in App Store Connect."
  lane :submit do |options|
    deliver(listing_options.merge(
      build_number: options[:build_number],
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    ).compact)
  end

  desc "Release an approved version (state: pending developer release); version: defaults to project.yml"
  lane :release do |options|
    wanted = options[:version].to_s.strip
    wanted = marketing_version if wanted.empty?
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found in App Store Connect") unless app
    version = app.get_pending_release_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    unless version && version.version_string == wanted
      UI.user_error!("Version #{wanted} is not waiting for release (not approved yet, or already released)")
    end
    version.create_app_store_version_release_request
    UI.success("Version #{wanted} released; it reaches the store within the next hours")
  end
end

def listing_options
  screenshots = Dir.exist?("screenshots") && !Dir.glob("screenshots/*/*.png").empty?
  {
    api_key: asc_api_key,
    app_identifier: APP_IDENTIFIER,
    app_version: marketing_version,
    metadata_path: "./fastlane/metadata",
    screenshots_path: "./fastlane/screenshots",
    skip_binary_upload: true,
    skip_screenshots: !screenshots,
    overwrite_screenshots: true,
    app_review_information: review_information,
    force: true, # no HTML preview to confirm on a headless run
    precheck_include_in_app_purchases: false
  }.compact
end

# The contact for App Review comes from the environment so it stays out of the public repo.
def review_information
  notes = File.read("metadata/review_information/notes.txt").strip
  contact = {
    first_name: ENV["REVIEW_FIRST_NAME"],
    last_name: ENV["REVIEW_LAST_NAME"],
    email_address: ENV["REVIEW_EMAIL"],
    phone_number: ENV["REVIEW_PHONE"]
  }.reject { |_, value| value.to_s.empty? }
  contact.merge(notes: notes, demo_required: false)
end

def normalized_serial(serial)
  serial.to_s.upcase.sub(/\A0+/, "")
end

def marketing_version
  File.read("../project.yml")[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
end
