{
  "sourceLanguage" : "de",
  "strings" : {
    "%@ bleiben für die drei markierten Felder nur %@, also fallen %@ in den übrigen Feldern %@ weg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, only %2$@ remain for the three marked cells, so %3$@ drop out of the other cells %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, para las tres casillas marcadas solo quedan %2$@, así que %3$@ se eliminan de las demás casillas %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, il ne reste que %2$@ pour les trois cases marquées, donc %3$@ disparaissent des autres cases %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ per le tre caselle segnate restano solo %2$@, quindi %3$@ vanno tolti dalle altre caselle %4$@."
          }
        }
      }
    },
    "%@ bleiben für die zwei markierten Felder nur %@, also fallen %@ in den übrigen Feldern %@ weg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, only %2$@ remain for the two marked cells, so %3$@ drop out of the other cells %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, para las dos casillas marcadas solo quedan %2$@, así que %3$@ se eliminan de las demás casillas %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, il ne reste que %2$@ pour les deux cases marquées, donc %3$@ disparaissent des autres cases %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ per le due caselle segnate restano solo %2$@, quindi %3$@ vanno tolti dalle altre caselle %4$@."
          }
        }
      }
    },
    "%@ ist %lld oder %lld, und so oder so wird eines der anderen markierten Felder zur %lld, also fällt die %lld in allen Feldern weg, die beide sehen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cell in %1$@ is %2$lld or %3$lld, and either way one of the other marked cells becomes a %4$lld, so the %5$lld drops out of every cell that sees both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@ hay un %2$lld o un %3$lld, y en cualquier caso una de las otras casillas marcadas será un %4$lld, así que el %5$lld se elimina de todas las casillas que ven a ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %1$@, il y a %2$lld ou %3$lld, et dans les deux cas une des autres cases marquées devient un %4$lld, donc le %5$lld disparaît de toutes les cases qui voient les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella %1$@ c'è %2$lld o %3$lld, e in ogni caso una delle altre caselle segnate diventa %4$lld, quindi la cifra %5$lld va tolta da tutte le caselle che le vedono entrambe."
          }
        }
      }
    },
    "%@ passen die %lld und die %lld nur in die zwei markierten Felder, also fallen dort alle anderen Ziffern weg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, the %2$lld and the %3$lld only fit in the two marked cells, so every other digit drops out there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, el %2$lld y el %3$lld solo caben en las dos casillas marcadas, así que allí se eliminan todas las demás cifras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, le %2$lld et le %3$lld ne peuvent aller que dans les deux cases marquées, donc tous les autres chiffres y disparaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ le cifre %2$lld e %3$lld possono stare solo nelle due caselle segnate, quindi lì vanno tolte tutte le altre cifre."
          }
        }
      }
    },
    "%@ passt die %lld nur noch in %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, the %2$lld only fits in %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, el %2$lld ya solo cabe en %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, le %2$lld ne peut plus aller que dans %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la cifra %2$lld può ormai stare solo nella %3$@."
          }
        }
      }
    },
    "%@ steht die %lld nur %@, also fällt die %lld im Rest %@ weg." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, the %2$lld only appears %3$@, so the %4$lld drops out of the rest %5$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, el %2$lld solo está %3$@, así que el %4$lld se elimina del resto %5$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, le %2$lld ne se trouve que %3$@, donc le %4$lld disparaît du reste %5$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ la cifra %2$lld sta solo %3$@, quindi la cifra %4$lld va tolta dal resto %5$@."
          }
        }
      }
    },
    "%@ und %@" : {
      "comment" : "Last two items of a list, e.g. \"3, 5 und 7\".",
      "localizations" : {
        "en" : {
