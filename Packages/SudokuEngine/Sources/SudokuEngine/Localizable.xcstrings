    "%@ bleiben für die drei markierten Felder nur %@, also fallen %@ in den übrigen Feldern %@ weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bleiben für die drei markierten Felder nur %@, also fallen %@ in den übrigen Feldern %@ weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, only %2$@ remain for the three marked cells, so %3$@ drop out of the other cells %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, para las tres casillas marcadas solo quedan %2$@, así que %3$@ se eliminan de las demás casillas %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, il ne reste que %2$@ pour les trois cases marquées, donc %3$@ disparaissent des autres cases %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ per le tre caselle segnate restano solo %2$@, quindi %3$@ vanno tolti dalle altre caselle %4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@では、印の付いた3つのマスに入るのは%2$@だけなので、%4$@の残りのマスから%3$@が消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 표시된 세 칸에는 %2$@만 남으므로, %4$@의 나머지 칸에서 %3$@ 후보가 빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ blijven voor de drie gemarkeerde vakjes alleen %2$@ over, dus vallen %3$@ af in de andere vakjes %4$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, para as três casas marcadas só restam %2$@, então %3$@ saem das demais casas %4$@."
          }
        }
      }
    },
