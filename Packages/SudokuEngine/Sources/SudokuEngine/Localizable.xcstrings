    "%@ ergeben alle Ziffern zusammen 45 und die Käfige ganz darin %lld, also ergeben die markierten Felder zusammen %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ergeben alle Ziffern zusammen 45 und die Käfige ganz darin %lld, also ergeben die markierten Felder zusammen %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, all digits add up to 45 and the cages entirely inside add up to %2$lld, so the marked cells add up to %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, todas las cifras suman 45 y las jaulas que están completamente dentro suman %2$lld, así que las casillas marcadas suman %3$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, tous les chiffres font 45 au total et les cages entièrement à l’intérieur %2$lld, donc les cases marquées font %3$lld au total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tutte le cifre fanno in totale 45 e le gabbie interamente all’interno %2$lld, quindi le caselle segnate fanno in totale %3$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@では、すべての数字の合計が45で、その中に完全に収まるケージの合計が%2$lldなので、印の付いたマスの合計は%3$lldです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 모든 숫자의 합은 45, 그 안에 완전히 들어 있는 케이지의 합은 %2$lld입니다. 따라서 표시된 칸의 합은 %3$lld입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tellen alle cijfers op tot 45 en de kooien die er helemaal in liggen tot %2$lld, dus tellen de gemarkeerde vakjes op tot %3$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, todos os dígitos somam 45 e as gaiolas totalmente dentro somam %2$lld, então as casas marcadas somam %3$lld."
          }
        }
      }
    },
    "%@ ergeben alle Ziffern zusammen 45 und die Käfige, die hineinreichen, %lld, also ergeben die markierten Felder außerhalb zusammen %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ergeben alle Ziffern zusammen 45 und die Käfige, die hineinreichen, %lld, also ergeben die markierten Felder außerhalb zusammen %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, all digits add up to 45 and the cages reaching into it add up to %2$lld, so the marked cells outside add up to %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, todas las cifras suman 45 y las jaulas que entran allí suman %2$lld, así que las casillas marcadas de fuera suman %3$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, tous les chiffres font 45 au total et les cages qui y entrent %2$lld, donc les cases marquées à l’extérieur font %3$lld au total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tutte le cifre fanno in totale 45 e le gabbie che vi entrano %2$lld, quindi le caselle segnate all’esterno fanno in totale %3$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@では、すべての数字の合計が45で、そこにかかるケージの合計が%2$lldなので、外側にある印の付いたマスの合計は%3$lldです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 모든 숫자의 합은 45, 그 안으로 걸쳐 들어오는 케이지의 합은 %2$lld입니다. 따라서 바깥쪽의 표시된 칸의 합은 %3$lld입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tellen alle cijfers op tot 45 en de kooien die erin doorlopen tot %2$lld, dus tellen de gemarkeerde vakjes erbuiten op tot %3$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, todos os dígitos somam 45 e as gaiolas que chegam ali somam %2$lld, então as casas marcadas de fora somam %3$lld."
          }
        }
      }
    },
    "%@ ist %lld oder %lld, und so oder so wird eines der anderen markierten Felder zur %lld, also fällt die %lld in allen Feldern weg, die beide sehen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist %lld oder %lld, und so oder so wird eines der anderen markierten Felder zur %lld, also fällt die %lld in allen Feldern weg, die beide sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cell in %1$@ is %2$lld or %3$lld, and either way one of the other marked cells becomes a %4$lld, so the %5$lld drops out of every cell that sees both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %1$@ hay un %2$lld o un %3$lld, y en cualquier caso una de las otras casillas marcadas será un %4$lld, así que el %5$lld se elimina de todas las casillas que ven a ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %1$@, il y a %2$lld ou %3$lld, et dans les deux cas une des autres cases marquées devient un %4$lld, donc le %5$lld disparaît de toutes les cases qui voient les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella %1$@ c'è %2$lld o %3$lld, e in ogni caso una delle altre caselle segnate diventa %4$lld, quindi la cifra %5$lld va tolta da tutte le caselle che le vedono entrambe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$lldか%3$lldで、どちらの場合も印の付いた他のマスのどれかが%4$lldになるので、その両方から見えるすべてのマスから%5$lldが消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 값은 %2$lld 또는 %3$lld 중 하나이고, 어느 쪽이든 표시된 다른 칸 중 하나는 반드시 %4$lld 값을 가지므로, 그 두 칸을 모두 보는 모든 칸에서 %5$lld 후보가 빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %1$@ staat een %2$lld of een %3$lld, en hoe dan ook wordt een van de andere gemarkeerde vakjes een %4$lld, dus valt de %5$lld af in alle vakjes die ze allebei zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na %1$@ há um %2$lld ou um %3$lld, e de qualquer forma uma das outras casas marcadas vira %4$lld, então o %5$lld sai de todas as casas que veem as duas."
          }
        }
      }
    },
