    "%@ passen die %lld und die %lld nur in die zwei markierten Felder, also fallen dort alle anderen Ziffern weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passen die %lld und die %lld nur in die zwei markierten Felder, also fallen dort alle anderen Ziffern weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, the %2$lld and the %3$lld only fit in the two marked cells, so every other digit drops out there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, el %2$lld y el %3$lld solo caben en las dos casillas marcadas, así que allí se eliminan todas las demás cifras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, le %2$lld et le %3$lld ne peuvent aller que dans les deux cases marquées, donc tous les autres chiffres y disparaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ le cifre %2$lld e %3$lld possono stare solo nelle due caselle segnate, quindi lì vanno tolte tutte le altre cifre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@では、%2$lldと%3$lldは印の付いた2つのマスにしか入らないので、そこから他の数字はすべて消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 숫자 %2$lld, %3$lld의 자리는 표시된 두 칸뿐이므로, 그 칸에서 다른 숫자 후보는 모두 빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ passen de %2$lld en de %3$lld alleen in de twee gemarkeerde vakjes, dus vallen daar alle andere cijfers af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, o %2$lld e o %3$lld só cabem nas duas casas marcadas, então todos os outros números saem delas."
          }
        }
      }
    },
