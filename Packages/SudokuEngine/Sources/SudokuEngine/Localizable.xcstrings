    },
    "In den Spalten %@ passt die %lld nur in die Zeilen %@, also fällt die %lld im Rest dieser Zeilen weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Spalten %@ passt die %lld nur in die Zeilen %@, also fällt die %lld im Rest dieser Zeilen weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In columns %1$@, the %2$lld only fits in rows %3$@, so the %4$lld drops out of the rest of these rows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las columnas %1$@, el %2$lld solo cabe en las filas %3$@, así que el %4$lld se elimina del resto de esas filas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les colonnes %1$@, le %2$lld ne peut aller que dans les lignes %3$@, donc le %4$lld disparaît du reste de ces lignes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle colonne %1$@ la cifra %2$lld può stare solo nelle righe %3$@, quindi la cifra %4$lld va tolta dal resto di queste righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@列目では、%2$lldは%3$@行目にしか入らないので、これらの行の残りのマスから%4$lldが消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@열에서 숫자 %2$lld의 자리는 %3$@행뿐이므로, 이 행들의 나머지 칸에서 %4$lld 후보가 빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de kolommen %1$@ past de %2$lld alleen in de rijen %3$@, dus valt de %4$lld af in de rest van die rijen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nas colunas %1$@, o %2$lld só cabe nas linhas %3$@, então o %4$lld sai do resto dessas linhas."
          }
        }
      }
    },
    "In den Zeilen %@ passt die %lld nur in die Spalten %@, also fällt die %lld im Rest dieser Spalten weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Zeilen %@ passt die %lld nur in die Spalten %@, also fällt die %lld im Rest dieser Spalten weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In rows %1$@, the %2$lld only fits in columns %3$@, so the %4$lld drops out of the rest of these columns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las filas %1$@, el %2$lld solo cabe en las columnas %3$@, así que el %4$lld se elimina del resto de esas columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les lignes %1$@, le %2$lld ne peut aller que dans les colonnes %3$@, donc le %4$lld disparaît du reste de ces colonnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle righe %1$@ la cifra %2$lld può stare solo nelle colonne %3$@, quindi la cifra %4$lld va tolta dal resto di queste colonne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@行目では、%2$lldは%3$@列目にしか入らないので、これらの列の残りのマスから%4$lldが消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@행에서 숫자 %2$lld의 자리는 %3$@열뿐이므로, 이 열들의 나머지 칸에서 %4$lld 후보가 빠집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de rijen %1$@ past de %2$lld alleen in de kolommen %3$@, dus valt de %4$lld af in de rest van die kolommen."
          }
