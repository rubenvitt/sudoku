    "Hier hilft „%@“. Tippe noch einmal auf Tipp, dann zeige ich dir die Stelle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier hilft „%@“. Tippe noch einmal auf Tipp, dann zeige ich dir die Stelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” helps here. Tap Hint again to see where."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí sirve «%@». Toca Pista otra vez para ver dónde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ici, « %@ » aide. Touche encore une fois Indice pour voir où."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui aiuta «%@». Tocca di nuovo Aiuto per vedere dove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは「%@」が使えます。もう一度ヒントをタップすると場所を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서는 ‘%@’ 기법이 도움이 됩니다. 힌트를 한 번 더 누르면 위치를 보여 드립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier helpt ‘%@’. Tik nog een keer op Tip om te zien waar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui ajuda “%@”. Toque em Dica de novo para ver onde."
          }
        }
      }
    },
