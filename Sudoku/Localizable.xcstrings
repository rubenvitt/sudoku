    "Ein Feld mit zwei Kandidaten zwingt eines von zwei Partnerfeldern zur selben Ziffer, also fällt sie überall weg, wo beide hinsehen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Feld mit zwei Kandidaten zwingt eines von zwei Partnerfeldern zur selben Ziffer, also fällt sie überall weg, wo beide hinsehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cell with two candidates forces one of two partner cells to the same digit, so it drops out wherever both can see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una casilla con dos candidatos obliga a una de dos casillas compañeras al mismo dígito, así que se descarta donde ven ambas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une case à deux candidats force l'une de deux cases partenaires au même chiffre : il disparaît donc partout où les deux voient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cella con due candidati costringe una di due celle partner alla stessa cifra, quindi si elimina ovunque le vedano entrambe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "候補が2つのマスが、2つの相手マスのどちらかを同じ数字に決めます。だから両方が見えるマスからその数字は消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후보가 둘인 칸이 두 짝 칸 중 하나를 같은 숫자로 만들어요. 그래서 둘 다 보는 칸에서 그 숫자가 지워져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vakje met twee kandidaten dwingt een van twee partnervakjes tot hetzelfde cijfer, dus valt het weg overal waar beide naartoe kijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma casa com dois candidatos força uma de duas casas parceiras ao mesmo dígito, então ele sai onde as duas enxergam."
          }
        }
      }
    },
    "Ein Feld, in das nur noch eine Ziffer passt." : {
