    "Welche der beiden Ziffern in welches Feld kommt, ist noch offen, aber beide sind vergeben. In den übrigen Feldern der Gruppe fallen sie deshalb weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche der beiden Ziffern in welches Feld kommt, ist noch offen, aber beide sind vergeben. In den übrigen Feldern der Gruppe fallen sie deshalb weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which of the two digits goes where is still open, but both are taken. So they drop out of the group's other cells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se sabe qué dígito va en cada casilla, pero los dos están ocupados. Por eso se descartan en las demás casillas del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On ne sait pas encore quel chiffre va où, mais les deux sont pris. Ils disparaissent donc des autres cases du groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si sa ancora quale cifra va dove, ma entrambe sono occupate. Per questo si eliminano dalle altre celle del gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらの数字がどちらのマスに入るかはまだ分かりませんが、2つとも使われます。だからグループのほかのマスからは消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 숫자가 어느 칸에 들어갈지는 아직 몰라도, 두 숫자 모두 쓰였어요. 그래서 그룹의 다른 칸에서는 지워져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welk van de twee cijfers waar komt, is nog open, maar beide zijn vergeven. Daarom vallen ze in de overige vakjes van de groep weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não se sabe qual dígito vai em qual casa, mas os dois estão ocupados. Por isso saem das outras casas do grupo."
          }
        }
      }
    },
    "Wie das Paar, mit drei Feldern und drei Ziffern." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie das Paar, mit drei Feldern und drei Ziffern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Like the pair, with three cells and three digits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como la pareja, con tres casillas y tres dígitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme la paire, avec trois cases et trois chiffres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come la coppia, con tre celle e tre cifre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアと同じで、3マスと3つの数字で考えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쌍과 같지만 세 칸과 세 숫자로 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoals het paar, met drie vakjes en drie cijfers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o par, com três casas e três dígitos."
          }
        }
      }
    },
