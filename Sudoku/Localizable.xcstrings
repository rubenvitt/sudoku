    "Passt eine Ziffer in zwei Zeilen nur in dieselben zwei Spalten, fällt sie im Rest dieser Spalten weg." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt eine Ziffer in zwei Zeilen nur in dieselben zwei Spalten, fällt sie im Rest dieser Spalten weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a digit fits only the same two columns in two rows, it drops out of the rest of those columns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si en dos filas un dígito solo cabe en las mismas dos columnas, se descarta en el resto de esas columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si, sur deux lignes, un chiffre ne tient que dans les deux mêmes colonnes, il disparaît du reste de ces colonnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se in due righe una cifra sta solo nelle stesse due colonne, si elimina dal resto di quelle colonne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの行である数字が同じ2つの列にしか入らないなら、その列の残りから消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 행에서 어떤 숫자가 같은 두 열에만 들어가면, 그 열의 나머지에서 지워져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Past een cijfer in twee rijen alleen in dezelfde twee kolommen, dan valt het in de rest van die kolommen weg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se em duas linhas um dígito só cabe nas mesmas duas colunas, ele sai do resto dessas colunas."
          }
        }
      }
    },
