    "Liegt eine Ziffer in einem Kasten nur in einer Zeile, fällt sie im Rest dieser Zeile weg, und umgekehrt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liegt eine Ziffer in einem Kasten nur in einer Zeile, fällt sie im Rest dieser Zeile weg, und umgekehrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a digit in a box lies only in one row, it drops out of the rest of that row, and the other way round."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si en un bloque un dígito solo está en una fila, se descarta en el resto de esa fila, y al revés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si, dans un bloc, un chiffre ne se trouve que sur une ligne, il disparaît du reste de cette ligne, et inversement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se in un riquadro una cifra sta solo in una riga, si elimina dal resto di quella riga, e viceversa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロック内である数字が1つの行にしかないなら、その行の残りから消えます。逆も同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상자 안에서 어떤 숫자가 한 행에만 있으면, 그 행의 나머지에서 지워집니다. 반대도 마찬가지예요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligt een cijfer in een blok maar in één rij, dan valt het in de rest van die rij weg, en omgekeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se num bloco um dígito só está numa linha, ele sai do resto dessa linha, e vice-versa."
          }
        }
      }
    },
