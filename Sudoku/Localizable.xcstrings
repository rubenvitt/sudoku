    "Auf jedem Thermometer steigen die Ziffern vom Kolben aus an." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf jedem Thermometer steigen die Ziffern vom Kolben aus an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On every thermometer the digits rise from the bulb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada termómetro los dígitos suben desde el bulbo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur chaque thermomètre, les chiffres montent depuis le bulbe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su ogni termometro le cifre salgono dal bulbo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サーモでは、数字が球から順に大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 온도계에서 숫자는 구에서부터 커집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op elke thermometer stijgen de cijfers vanaf het bolletje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em cada termômetro os dígitos sobem a partir do bulbo."
          }
        }
      }
    },
