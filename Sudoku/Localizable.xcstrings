    "Zwei Felder einer Gruppe mit denselben zwei Kandidaten teilen sie unter sich auf." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Felder einer Gruppe mit denselben zwei Kandidaten teilen sie unter sich auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two cells of a group with the same two candidates share them between them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos casillas de un grupo con los mismos dos candidatos se los reparten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux cases d'un groupe avec les deux mêmes candidats se les partagent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due celle di un gruppo con gli stessi due candidati se li dividono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じグループで同じ2つの候補を持つ2マスは、その2つを分け合います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 그룹에서 같은 두 후보를 가진 두 칸은 그 둘을 나눠 가져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee vakjes van een groep met dezelfde twee kandidaten verdelen die onder elkaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas casas de um grupo com os mesmos dois candidatos dividem-nos entre si."
          }
        }
      }
    },
    "Zwei Ziffern, die in einer Gruppe nur in dieselben zwei Felder passen, belegen diese Felder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Ziffern, die in einer Gruppe nur in dieselben zwei Felder passen, belegen diese Felder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two digits that fit only the same two cells of a group take those cells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dígitos que en un grupo solo caben en las mismas dos casillas las ocupan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux chiffres qui, dans un groupe, ne tiennent que dans les deux mêmes cases occupent ces cases."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due cifre che in un gruppo stanno solo nelle stesse due celle le occupano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループ内で同じ2マスにしか入らない2つの数字は、その2マスを占めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹 안에서 같은 두 칸에만 들어갈 수 있는 두 숫자는 그 칸을 차지해요."
