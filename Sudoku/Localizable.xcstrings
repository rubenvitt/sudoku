    "Statt Kästen gibt es neun verwinkelte Gebiete, jedes enthält 1 bis 9." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt Kästen gibt es neun verwinkelte Gebiete, jedes enthält 1 bis 9."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instead of boxes there are nine irregular regions, each holding 1 to 9."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lugar de bloques hay nueve regiones irregulares, y cada una contiene del 1 al 9."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la place des blocs, neuf zones irrégulières contiennent chacune 1 à 9."
          }
        },
        "it" : {
          "stringUnit" : {
