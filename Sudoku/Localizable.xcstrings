    "Schau in die markierte Gegend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau in die markierte Gegend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the highlighted area."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la zona marcada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde la zone surlignée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la zona evidenziata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色の付いた範囲を見てください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시된 영역을 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk naar het gemarkeerde gebied."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe a área destacada."
          }
        }
      }
    },
    "Schau, welche Ziffern in der Zeile, der Spalte und dem Kasten des Feldes schon stehen. Fehlt nur noch eine, gehört sie hinein." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau, welche Ziffern in der Zeile, der Spalte und dem Kasten des Feldes schon stehen. Fehlt nur noch eine, gehört sie hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check which digits are already in the cell's row, column and box. If only one is missing, it belongs there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira qué dígitos hay ya en la fila, la columna y el bloque de la casilla. Si solo falta uno, va ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde quels chiffres figurent déjà dans la ligne, la colonne et le bloc de la case. S'il n'en manque qu'un, c'est lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda quali cifre ci sono già nella riga, nella colonna e nel riquadro della cella. Se ne manca solo una, va lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのマスの行・列・ブロックにすでにある数字を確かめます。足りないのが1つだけなら、それが入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 칸의 행, 열, 상자에 이미 있는 숫자를 확인하세요. 하나만 빠져 있다면 그 숫자가 들어가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk welke cijfers al in de rij, de kolom en het blok van het vakje staan. Ontbreekt er nog maar één, dan hoort die erin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quais dígitos já estão na linha, na coluna e no bloco da casa. Se só falta um, é ele."
          }
        }
      }
    },
