    "In Zeile %lld stimmt etwas nicht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Zeile %lld stimmt etwas nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something is wrong in row %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo no cuadra en la fila %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose ne va pas dans la ligne %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa non va nella riga %lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld行目に間違いがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld행에 잘못된 곳이 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In rij %lld klopt iets niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há algo errado na linha %lld."
          }
        }
      }
    },
    "In jeder der beiden Zeilen steht die Ziffer in einer der zwei Spalten, also über Kreuz. Damit ist sie in beiden Spalten vergeben. Mit Zeilen und Spalten vertauscht geht es genauso." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In jeder der beiden Zeilen steht die Ziffer in einer der zwei Spalten, also über Kreuz. Damit ist sie in beiden Spalten vergeben. Mit Zeilen und Spalten vertauscht geht es genauso."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In each of the two rows the digit stands in one of the two columns, so crosswise. That takes it in both columns. It works the same with rows and columns swapped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cada una de las dos filas el dígito está en una de las dos columnas, en cruz. Así queda ocupado en ambas columnas. Con filas y columnas intercambiadas funciona igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur chacune des deux lignes, le chiffre est dans l'une des deux colonnes, donc en croix. Il est ainsi pris dans les deux colonnes. C'est pareil en échangeant lignes et colonnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ognuna delle due righe la cifra sta in una delle due colonne, quindi a incrocio. Così è occupata in entrambe le colonne. Scambiando righe e colonne funziona allo stesso modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの行のそれぞれで、その数字は2つの列のどちらかに入ります。つまり交差する形です。だから両方の列でその数字は使われます。行と列を入れ替えても同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 행 각각에서 그 숫자는 두 열 중 하나에 들어가요. 엇갈리는 모양이죠. 그래서 두 열 모두에서 그 숫자는 쓰인 셈이에요. 행과 열을 바꿔도 같아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In elk van de twee rijen staat het cijfer in een van de twee kolommen, dus kruiselings. Daarmee is het in beide kolommen vergeven. Met rijen en kolommen verwisseld werkt het net zo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em cada uma das duas linhas o dígito está numa das duas colunas, em cruz. Assim ele fica ocupado nas duas colunas. Trocando linhas e colunas funciona igual."
          }
        }
      }
    },
