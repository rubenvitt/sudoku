            "value" : "Chaque ligne, colonne et bloc contient 1 à 9."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga, colonna e riquadro contiene da 1 a 9."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの行・列・ブロックにも1〜9が1つずつ入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 행, 열, 상자에 1부터 9까지 들어갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke rij, kolom en elk blok bevat 1 tot en met 9."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha, coluna e bloco contém de 1 a 9."
          }
        }
      }
