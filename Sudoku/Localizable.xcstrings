    "Jede Zeile, Spalte und jeder Kasten braucht jede Ziffer genau einmal. Sind alle anderen Felder für eine Ziffer gesperrt, muss sie in das letzte." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile, Spalte und jeder Kasten braucht jede Ziffer genau einmal. Sind alle anderen Felder für eine Ziffer gesperrt, muss sie in das letzte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every row, column and box needs each digit exactly once. If all other cells are closed to a digit, it must go in the last one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila, columna y bloque necesita cada dígito exactamente una vez. Si todas las demás casillas están cerradas para un dígito, va en la última."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne, colonne et bloc contient chaque chiffre une seule fois. Si toutes les autres cases lui sont fermées, il va dans la dernière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga, colonna e riquadro ha bisogno di ogni cifra esattamente una volta. Se tutte le altre celle sono chiuse a una cifra, va nell'ultima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの行・列・ブロックにも各数字がちょうど1回入ります。ほかのマスにある数字が入れないなら、残った1マスに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 행, 열, 상자에는 각 숫자가 정확히 한 번 들어가요. 다른 칸에 그 숫자가 모두 들어갈 수 없다면 마지막 칸에 들어가요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke rij, kolom en elk blok heeft elk cijfer precies één keer nodig. Is een cijfer in alle andere vakjes uitgesloten, dan moet het in het laatste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha, coluna e bloco precisa de cada dígito exatamente uma vez. Se todas as outras casas estão fechadas para um dígito, ele vai na última."
          }
        }
      }
    },
    "Jede Zeile, Spalte und jeder Kasten enthält 1 bis 9." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile, Spalte und jeder Kasten enthält 1 bis 9."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every row, column and box holds 1 to 9."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila, columna y bloque contiene del 1 al 9."
          }
        },
        "fr" : {
          "stringUnit" : {
